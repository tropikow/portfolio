---
import { education, languages, softSkills } from '../data/profile';
---

<section id="about">
	<div class="wrap">
		<div class="trio">
			<div>
				<h3>Soft Skills</h3>
				<ul>
					{
						softSkills.map((skill) => (
							<li>
								<b>{skill.title}</b> — {skill.description}
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3>Languages</h3>
				<ul>
					{
						languages.map((language) => (
							<li>
								<b>{language.name}</b> — {language.level}
							</li>
						))
					}
				</ul>
			</div>
			<div id="education">
				<h3>Education</h3>
				<ul>
					{education.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</div>
	</div>
</section>
