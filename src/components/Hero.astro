---
import { contact, heroSnippet } from '../data/profile';
---

<section class="hero" id="home">
	<div class="wrap hero-grid">
		<div>
			<h1 class="hero-headline">Build. <em>Automate.</em> Ship.</h1>
			<p class="hero-sub">{contact.name} — {contact.role}</p>
			<div class="hero-meta">
				{contact.location} &nbsp;|&nbsp;
				<a href={`tel:${contact.phone}`}>{contact.phone}</a> &nbsp;|&nbsp;
				<a href={`mailto:${contact.email}`}>{contact.email}</a>
				<br />
				<a href={contact.linkedinUrl} target="_blank" rel="noopener">LinkedIn</a> &nbsp;|&nbsp;
				<a href={contact.githubUrl} target="_blank" rel="noopener">GitHub</a>
			</div>
			<div class="hero-cta">
				<a class="aqua-btn" href="#experience">View Experience</a>
			</div>
			<p class="hero-timestamp">Full Stack Developer since 2021 &middot; Available for new opportunities</p>
		</div>

		<div class="glass-window">
			<div class="glass-titlebar">
				<span class="traffic red"></span>
				<span class="traffic yellow"></span>
				<span class="traffic green"></span>
				<span class="glass-titletext">profile.ts — jovannyruiz</span>
			</div>
			<pre class="glass-code">{heroSnippet.join('\n')}</pre>
		</div>
	</div>
</section>
